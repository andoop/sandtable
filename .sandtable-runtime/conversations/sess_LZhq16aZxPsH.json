      "feature": "2026-06-13-mobile-on-demand-sync",
      "role": "mobile",
      "kind": "chat",
      "text": "匹配码逻辑是怎样的",
      "payload": {
        "target": "conversation"
      },
      "agent": {
        "id": "custom-1NBm-ZIn",
